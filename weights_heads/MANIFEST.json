 "key_format": "<arch>|<DOMAIN>|<fold>|<tensor name>",
 "n_entries": 4320,
 "n_checkpoints": 90,
 "note": "ViT and ConvNeXt use layer normalisation: only the classifier tensors ever change, so their backbones are byte-identical across all 30 checkpoints each. MobileNetV3 uses batch normalisation, whose running statistics adapt to the training split even with every weight frozen; those buffers are stored here too so a model can be reconstructed exactly. They are never updated on an evaluation fold -- training runs model.train() only over the inner training split.",
 "n_models": 90,
 "frozen_backbone_sha256_definition": "sha256 over every tensor NOT present in heads.npz, in sorted key order, each as key bytes followed by the C-contiguous raw array bytes. These tensors are byte-identical across all 30 checkpoints of the architecture. load_trained_model.py recomputes this from the freshly built pretrained model and warns on a mismatch, which would mean the upstream ImageNet weights have changed.",
 "tensors_stored_per_model": {
  "ViT": 2,
  "ConvNeXt": 2,
  "MobileNetV3": 140
 },
 "extraction_rule": "For each architecture, the set of tensors that ever differ between any two of its 30 checkpoints is stored for EVERY checkpoint -- not only where it differs from a reference. Storing only the differences would silently omit a tensor that happens to equal the reference while differing from the pretrained value, which is exactly what analysis/verify_weights.py caught."
